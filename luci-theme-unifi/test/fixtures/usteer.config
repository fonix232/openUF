config usteer
	option network 'lan'
	option syslog '1'
	option local_mode '0'
	option ipv6 '0'
	option debug_level '2'
	option band_steering_interval '30000'
	option band_steering_min_snr '-60'
	option roam_scan_snr '-70'
	option roam_trigger_snr '-75'
	option signal_diff_threshold '8'
	list ssid_list 'HomeNet'
