{#
 luci-theme-unifi: the sign-in card.

 A plain form POST, as LuCI's dispatcher expects, so signing in works even
 before any JavaScript has loaded.
 Licensed to the public under the Apache License 2.0.
-#}

{% include('header', { blank_page: true }) %}

{% const board = ubus.call('system', 'board'); %}

<main class="uf-login">
	<form method="post" class="uf-login-card">
		<div class="uf-login-brand">
			<span class="uf-appicon" aria-hidden="true"></span>
			<span>{{ striptags(version.distname ?? 'OpenWrt') }}</span>
		</div>

		<h1 class="uf-login-title">{{ striptags(board?.hostname ?? '?') }}</h1>
		<p class="uf-login-sub">{{ _('Authorization Required') }}</p>

		{% if (fuser): %}
		<div class="alert-message error" role="alert">
			{{ _('Invalid username and/or password! Please try again.') }}
		</div>
		{% endif %}

		<label class="uf-field" for="luci_username">
			<span>{{ _('Username') }}</span>
			<input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}" autocapitalize="off" spellcheck="false">
		</label>

		<label class="uf-field" for="luci_password">
			<span>{{ _('Password') }}</span>
			<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus>
		</label>

		<button type="submit" class="btn cbi-button cbi-button-positive important uf-login-submit">{{ _('Log in') }}</button>
	</form>

	<p class="uf-login-foot">
		{{ striptags(board?.model ?? '') }}
		{% if (board?.model): %}&middot;{% endif %}
		{{ version.distname }} {{ version.distversion }}
	</p>
</main>

{% include('footer', { blank_page: true }) %}
