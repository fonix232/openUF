#!/bin/sh

# Register the theme and its two fixed-scheme variants. "UniFi" follows the
# browser's colour scheme and offers a toggle in the top bar; "UniFiDark" and
# "UniFiLight" pin one scheme for everybody and hide the toggle.
changed=0
registered=0

set_opt() {
	if ! uci -q get "luci.$1" >/dev/null; then
		uci set "luci.$1=$2"
		changed=1
	fi
}

add_theme() {
	if ! uci -q get "luci.themes.$1" >/dev/null; then
		set_opt "themes.$1" "$2"
		registered=1
	fi
}

add_theme UniFi /luci-static/unifi
add_theme UniFiDark /luci-static/unifi-dark
add_theme UniFiLight /luci-static/unifi-light

# The theme's own settings (System > UniFi Theme): the Interfaces and
# Wireless designs (list, settings or cards) and the Port Manager on
# Interfaces. Only what is missing is set; a choice already made stays.
set_opt unifi internal
set_opt unifi.interfaces list
set_opt unifi.wireless list
set_opt unifi.port_manager 1

# Installing a theme is asking to use it, so switch to it on a fresh install,
# but leave the choice alone on an upgrade.
if [ "$PKG_UPGRADE" != 1 ] && [ $registered = 1 ]; then
	uci set luci.main.mediaurlbase=/luci-static/unifi
fi

[ $changed = 1 ] && uci commit luci

exit 0
