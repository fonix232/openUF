# The lab's network, copied in before first boot so OpenWrt does not
# generate its own (see run.sh). eth0, Docker's link that LuCI is reached
# over, is left out: br-lan starts empty and add-ports.sh gives it ports.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option ula_prefix 'fd12:3456:789a::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	option bridge_empty '1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.1/24'
	option ip6assign '60'
