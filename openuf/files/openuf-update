#!/bin/sh
# openuf-update: upgrade openUF from the openUF feed, and go back when the new
# version does not come up.
#
# apk/opkg install the new package and restart the service; this then waits
# for the daemon's first completed inform cycle (it writes /tmp/openuf-status
# after each one) and, if none arrives, reinstalls the version that was
# running before -- the feed keeps the last few.
#
#   openuf-update            update, check, roll back on failure
#   openuf-update --check    only say whether the feed has a newer version

STATUS_FILE=/tmp/openuf-status
FEED=https://fonix232.github.io/openUF
DEADLINE=75     # seconds for the new daemon's first completed cycle

say()  { echo "openuf-update: $*"; logger -t openuf-update "$*"; }
die()  { say "$*"; exit 1; }
status_val() { sed -n "s/^$1=//p" "$STATUS_FILE" 2>/dev/null; }

if command -v apk >/dev/null 2>&1; then
	refresh()   { apk update >/dev/null 2>&1; }
	current()   { apk list -I "$1" 2>/dev/null | sed -n "s/^$1-\([0-9][^ ]*\) .*/\1/p" | head -1; }
	newest()    { apk list -a "$1" 2>/dev/null | sed -n "s/^$1-\([0-9][^ ]*\) .*/\1/p" | sort -V | tail -1; }
	# `apk upgrade <names>`, not `apk add --upgrade`: the latter upgrades the
	# whole dependency tree too (luci-base, libopenssl...), which is not this
	# tool's call to make.
	upgrade()   { apk upgrade "$@"; }
	downgrade() { apk add "$1=$2"; }
else
	refresh()   { opkg update >/dev/null 2>&1; }
	current()   { opkg list-installed "$1" 2>/dev/null | sed -n "s/^$1 - //p"; }
	newest()    { opkg list "$1" 2>/dev/null | sed -n "s/^$1 - \([^ ]*\).*/\1/p" | sort -V | tail -1; }
	upgrade()   { opkg upgrade "$@"; }
	downgrade() { opkg install --force-downgrade "$FEED/ipk/${1}_${2}_all.ipk"; }
fi

before=$(current openuf)
[ -n "$before" ] || die "openuf is not installed as a package"
pkgs=openuf
[ -n "$(current luci-app-openuf)" ] && pkgs="$pkgs luci-app-openuf"
refresh || die "cannot reach the package feeds"
latest=$(newest openuf)

if [ "${1:-}" = "--check" ]; then
	[ "$latest" != "$before" ] && [ -n "$latest" ] \
		&& { say "openuf $before installed, $latest available"; exit 0; }
	say "openuf $before is the newest"; exit 0
fi
[ -n "$latest" ] && [ "$latest" = "$before" ] && { say "openuf $before is the newest"; exit 0; }

started=$(date +%s)
upgrade $pkgs || die "the upgrade failed; openuf $before is still installed"
after=$(current openuf)
[ "$after" = "$before" ] && { say "nothing to upgrade (openuf $before)"; exit 0; }

# A transport failure counts as alive: the loop ran, and a controller that is
# down would fail the old version the same way.
waited=0 health=none
while [ "$waited" -lt "$DEADLINE" ]; do
	sleep 5; waited=$((waited + 5))
	ok=$(status_val last_ok); fail=$(status_val last_fail)
	[ -n "$ok" ] && [ "$ok" -ge "$started" ] 2>/dev/null && { health=ok; break; }
	[ -n "$fail" ] && [ "$fail" -ge "$started" ] 2>/dev/null && health=unanswered
done

case "$health" in
	ok)         say "updated openuf $before -> $after; the controller answered" ;;
	unanswered) say "updated openuf $before -> $after; running, but the controller has not answered yet: $(status_val last_fail_msg)" ;;
	*)
		say "openuf $after did not complete an inform within ${DEADLINE}s; going back to $before"
		downgrade openuf "$before" || die "rollback failed: reinstall openuf $before by hand"
		exit 1 ;;
esac
